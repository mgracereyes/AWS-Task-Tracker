# PostgreSQL 16 (SQLAlchemy URL with the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://task_tracker:change-me@localhost:5432/task_tracker
# Signs the session cookie. Use a long random value; keep it in the secrets store in production.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8
# Only this domain can sign in (FR-001)
ALLOWED_DOMAIN=awsys-i.com
# These emails become Admin on first sign-in (FR-002)
ADMIN_EMAILS=fay.ong@awsys-i.com
# Google sign-in (FR-001). Leave empty while SSO is on hold (WBS T07).
GOOGLE_CLIENT_ID=
# Development-only email sign-in. MUST be false in production.
DEV_LOGIN=true
# Frontend address, for CORS and the session cookie
FRONTEND_URL=http://localhost:5173
# true on HTTPS servers (sets Secure on the cookie)
COOKIE_SECURE=false
# Folder for export files
EXPORT_DIR=./exports
